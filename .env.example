# Steam upload configuration.
# Copy this file to .env and fill in the values:
#     cp .env.example .env
#
# Required
STEAM_APP_ID=
STEAM_DEPOT_ID=

# Optional
# Platform to build/upload: linux (default), windows, or mac.
# STEAM_PLATFORM=linux

# Steam account used to upload (steamcmd will prompt for password / Steam Guard
# when this is omitted, as long as you have logged in once).
# STEAM_USERNAME=

# Branch to publish to. Leave empty to upload WITHOUT setting the build live
# on any branch (recommended first, then set it live from Steamworks to test).
# STEAM_SETLIVE=beta

# Build description shown in Steamworks.
# STEAM_BUILD_DESC=

# Where the unpacked build lives. Defaults per platform:
#   linux   -> dist/linux-unpacked
#   windows -> dist/win-unpacked
#   mac     -> dist/mac-universal (then mac-arm64, then mac)
# STEAM_CONTENT_SOURCE=dist/linux-unpacked

# Path to the steamcmd executable (default: steamcmd on PATH). On Windows use
# e.g. C:\steamcmd\steamcmd.exe
# STEAMCMD=steamcmd

# Private HOME used for the steamcmd login cache (keeps the Steam client from
# clobbering it). Defaults to ~/.genesis-steamcmd. The first upload prompts for
# your password / Steam Guard; later uploads reuse the cached login.
# STEAMCMD_HOME=

# Per-platform depot IDs. STEAM_DEPOT_ID works as the default/fallback.
# STEAM_DEPOT_ID_LINUX=
# STEAM_DEPOT_ID_WINDOWS=
# STEAM_DEPOT_ID_MAC=
