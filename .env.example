# Steam upload configuration.
# Copy this file to .env and fill in the values:
#     cp .env.example .env
#
# Required
STEAM_APP_ID=
STEAM_DEPOT_ID=

# Optional
# Steam account used to upload (steamcmd will prompt for password / Steam Guard
# when this is omitted, as long as you have logged in once).
# STEAM_USERNAME=

# Branch to publish to. Leave empty for the default branch.
# STEAM_SETLIVE=beta

# Build description shown in Steamworks.
# STEAM_BUILD_DESC=

# Where the unpacked Linux build lives (default: dist/linux-unpacked).
# STEAM_CONTENT_SOURCE=dist/linux-unpacked

# Path to the steamcmd executable (default: steamcmd on PATH).
# STEAMCMD=steamcmd
