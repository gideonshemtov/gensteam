{
  "name": "genesis-electron",
  "version": "1.0.21",
  "description": "Genesis MUD — Official Desktop Client",
  "main": "main.js",
  "author": "Genesis Mud",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder -w",
    "dist:win:dir": "electron-builder --win --dir",
    "dist:mac": "electron-builder -m",
    "dist:mac:dir": "electron-builder --mac --dir --universal",
    "dist:linux": "electron-builder -l",
    "dist:linux:dir": "electron-builder --linux --dir",
    "steam:prepare": "node steam/upload.js --prepare",
    "steam:login": "node steam/upload.js --login",
    "steam:upload": "node steam/upload.js",
    "steam:upload:mac": "node steam/upload.js --platform=mac",
    "steam:release:mac": "pnpm run dist:mac:dir && pnpm run steam:upload:mac",
    "steam:release:linux": "pnpm run dist:linux:dir && pnpm run steam:upload:docker",
    "steam:upload:docker": "bash steam/docker-upload.sh"
  },
  "build": {
    "appId": "org.genesis.client",
    "productName": "GenesisClient",
    "icon": "assets/icon",
    "files": [
      "**/*",
      "!dist",
      "!.git",
      "!.env",
      "!.claude",
      "!steam",
      "!steam/**/*",
      "!test",
      "!test/**/*",
      "!scripts",
      "!scripts/**/*",
      "!pnpm-lock.yaml",
      "!pnpm-workspace.yaml"
    ],
    "asarUnpack": [
      "assets/sounds/**/*"
    ],
    "mac": {
      "category": "public.app-category.games",
      "icon": "assets/icon.png",
      "extendInfo": {
        "LSUIElement": false,
        "LSBackgroundOnly": false
      }
    },
    "win": {
      "target": {
        "target": "nsis",
        "arch": ["x64"]
      },
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GenesisClient"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "ajv": "^8.12.0"
  },
  "devDependencies": {
    "electron": "38.0.0",
    "electron-builder": "26.0.19"
  }
}
